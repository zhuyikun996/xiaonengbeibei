.poster-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.poster-container {
  width: 85%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.poster-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.poster-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.poster-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999;
}

.poster-canvas-wrap {
  padding: 24rpx;
  display: flex;
  justify-content: center;
}

.poster-canvas {
  width: 600rpx;
  height: 1000rpx;
}

.poster-actions {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 36rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn-save {
  background: #4A90D9;
  color: #fff;
}

.action-btn-save:active {
  background: #3A7BC8;
}

.action-btn-share {
  background: #F5A623;
  color: #fff;
}

.action-btn-share:active {
  background: #E09520;
}
