.home {
  padding: 60rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.wordset-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.wordset-card {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.wordset-card--active {
  border-left: 6rpx solid #4A90D9;
}

.wordset-card:active {
  background: #f9f9f9;
}

.wordset-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.wordset-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.wordset-subtitle {
  font-size: 26rpx;
  color: #999;
}

.wordset-count {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.count-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #4A90D9;
}

.count-label {
  font-size: 24rpx;
  color: #999;
}

/* 进度条 */
.wordset-progress {
  width: 100%;
  margin-top: 20rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: #4A90D9;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-bar-fill--done {
  background: #52c41a;
}

.progress-text {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.progress-label {
  font-size: 22rpx;
  color: #666;
  font-weight: 600;
}

.progress-label--done {
  color: #52c41a;
}

.progress-detail {
  font-size: 22rpx;
  color: #999;
}
