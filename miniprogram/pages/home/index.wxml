<view class="home">
  <view class="header">
    <text class="title">选择背诵范围</text>
    <text class="subtitle">请选择一个词表开始背单词</text>
  </view>

  <view class="wordset-list">
    <view
      class="wordset-card {{item.setId === currentSetId ? 'wordset-card--active' : ''}}"
      wx:for="{{wordSets}}"
      wx:key="setId"
      data-setid="{{item.setId}}"
      bindtap="onSelectWordSet"
    >
      <view class="wordset-info">
        <text class="wordset-title">{{item.title}}</text>
        <text class="wordset-subtitle">{{item.subtitle}}</text>
      </view>
      <view class="wordset-count">
        <text class="count-number">{{item.totalWords}}</text>
        <text class="count-label">词</text>
      </view>
      <view class="wordset-progress">
        <view class="progress-bar">
          <view class="progress-bar-fill {{item.completed ? 'progress-bar-fill--done' : ''}}" style="width: {{item.percent}}%"></view>
        </view>
        <view class="progress-text">
          <text wx:if="{{item.completed}}" class="progress-label progress-label--done">已完成</text>
          <text wx:else class="progress-label">{{item.percent}}%</text>
          <text class="progress-detail">已学 {{item.learned}}/{{item.totalWords}} 词</text>
        </view>
      </view>
    </view>
  </view>
</view>
