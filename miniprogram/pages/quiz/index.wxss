.quiz {
  padding: 24rpx 32rpx 180rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部导航 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.top-bar-right {
  display: flex;
  gap: 20rpx;
}

.top-btn {
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 32rpx;
  border: 2rpx solid #e5e5e5;
}

.top-btn:active {
  background: #f5f5f5;
}

.top-btn-text {
  font-size: 24rpx;
  color: #666;
}

/* 进度条 */
.progress-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.progress-bar-bg {
  flex: 1;
  height: 12rpx;
  background: #e5e5e5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: #4A90D9;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
}

/* 词表标签 */
.wordset-tag {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 32rpx;
}

/* 单词卡片 */
.word-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.word-main {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.word-en {
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
}

.word-meta {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
}

.word-pos {
  font-size: 28rpx;
  color: #4A90D9;
  font-style: italic;
}

.word-meaning {
  font-size: 32rpx;
  color: #666;
}

.alternatives {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.alt-text {
  font-size: 24rpx;
  color: #999;
}

/* 通用区块 */
.section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 32rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.section-toggle {
  font-size: 24rpx;
  color: #999;
}

.section-content {
  padding: 0 32rpx 28rpx;
  border-top: 1rpx solid #f5f5f5;
}

/* 例句 */
.example-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 0;
}

.example-item:not(:last-child) {
  border-bottom: 1rpx solid #f5f5f5;
}

.example-en {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.example-zh {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.example-source {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

/* 练习题 */
.exercise-item {
  padding: 20rpx 0;
}

.exercise-type-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #4A90D9;
  background: #EBF3FC;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.exercise-question {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-line;
}

.exercise-answer {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #F0FFF0;
  border-radius: 12rpx;
  border-left: 6rpx solid #4CAF50;
}

.answer-label {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 600;
}

.answer-text {
  font-size: 28rpx;
  color: #333;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.nav-btn {
  padding: 20rpx 48rpx;
  border-radius: 44rpx;
  text-align: center;
}

.nav-btn-prev {
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
}

.nav-btn-prev:active {
  background: #e8e8e8;
}

.nav-btn-next {
  background: #4A90D9;
  color: #fff;
  font-size: 28rpx;
}

.nav-btn-next:active {
  background: #3A7BC8;
}

.nav-btn.disabled {
  opacity: 0.4;
}
