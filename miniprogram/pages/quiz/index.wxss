.quiz {
  padding: 24rpx 32rpx 180rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 阶段指示 */
.phase-indicator {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.phase-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.phase-badge--study {
  background: #ebf3fc;
  color: #4A90D9;
}

.phase-badge--test {
  background: #f2f0ff;
  color: #6554C0;
}

.phase-badge--review {
  background: #fff3e6;
  color: #F5A623;
}

.phase-badge--done {
  background: #f0fff4;
  color: #34c759;
}

/* 顶部导航 */
.top-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 24rpx;
}

.top-bar-right {
  display: flex;
  gap: 20rpx;
}

.top-btn {
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 32rpx;
  border: 2rpx solid #e5e5e5;
}

.top-btn:active {
  background: #f5f5f5;
}

.top-btn-text {
  font-size: 24rpx;
  color: #666;
}

/* 进度条 */
.progress-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.progress-bar-bg {
  flex: 1;
  height: 12rpx;
  background: #e5e5e5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: #4A90D9;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
}

.mode-switch {
  display: flex;
  padding: 8rpx;
  background: #f2f6fb;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

.mode-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: #6b7280;
  transition: all 0.2s ease;
}

.mode-btn.active {
  background: #4A90D9;
  color: #fff;
  font-weight: 600;
}

.session-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.session-stat {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.session-stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.session-stat-value--green {
  color: #34c759;
}

.session-stat-value--red {
  color: #ff6b6b;
}

.session-stat-value--blue {
  color: #4A90D9;
}

.session-stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

/* 词表标签 */
.wordset-tag {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.test-card {
  background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
  border-radius: 16rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.test-card-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: #ebf3fc;
  color: #4A90D9;
  font-size: 22rpx;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
}

.test-card-question {
  display: block;
  font-size: 38rpx;
  line-height: 1.6;
  color: #222;
  margin-bottom: 12rpx;
  white-space: pre-line;
}

.test-card-hint {
  display: block;
  font-size: 26rpx;
  color: #4A90D9;
  margin-bottom: 28rpx;
}

.choice-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.choice-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx;
  background: #fff;
  border: 2rpx solid #d7e6f8;
  border-radius: 16rpx;
}

.choice-item:active {
  background: #f3f8ff;
  border-color: #4A90D9;
}

.choice-key {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 22rpx;
  background: #4A90D9;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.choice-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

.feedback-card {
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.feedback-card.correct {
  background: #f1fff4;
  border-left: 8rpx solid #34c759;
}

.feedback-card.wrong {
  background: #fff6f6;
  border-left: 8rpx solid #ff6b6b;
}

.feedback-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.feedback-text {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.feedback-extra {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #333;
}

/* 填空题 */
.fill-input {
  width: 100%;
  height: 80rpx;
  background: #fff;
  border: 2rpx solid #d7e6f8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.fill-submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: #4A90D9;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.fill-submit-btn:active {
  background: #3A7BC8;
}

/* 单词卡片 */
.word-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.word-main {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.word-en {
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
}

.word-phonetic {
  font-size: 26rpx;
  color: #999;
  line-height: 1.4;
}

.word-meta {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
}

.word-pos {
  font-size: 28rpx;
  color: #4A90D9;
  font-style: italic;
}

.word-meaning {
  font-size: 32rpx;
  color: #666;
}

.alternatives {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.alt-text {
  font-size: 24rpx;
  color: #999;
}

/* 通用区块 */
.section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 32rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.section-toggle {
  font-size: 24rpx;
  color: #999;
}

.section-content {
  padding: 0 32rpx 28rpx;
  border-top: 1rpx solid #f5f5f5;
}

/* 例句 */
.example-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 0;
}

.example-item:not(:last-child) {
  border-bottom: 1rpx solid #f5f5f5;
}

.example-en {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
}

.example-zh {
  font-size: 30rpx;
  color: #666;
  line-height: 1.6;
}

.example-source {
  font-size: 26rpx;
  color: #bbb;
  margin-top: 4rpx;
}

/* 练习题 */
.exercise-item {
  padding: 20rpx 0;
}

.exercise-type-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #4A90D9;
  background: #EBF3FC;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.exercise-question {
  font-size: 32rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-line;
}

.exercise-answer {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #F0FFF0;
  border-radius: 12rpx;
  border-left: 6rpx solid #4CAF50;
}

.answer-label {
  font-size: 30rpx;
  color: #4CAF50;
  font-weight: 600;
}

.answer-text {
  font-size: 32rpx;
  color: #333;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.nav-btn {
  padding: 20rpx 48rpx;
  border-radius: 44rpx;
  text-align: center;
}

.nav-btn-prev {
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
}

.nav-btn-prev:active {
  background: #e8e8e8;
}

.nav-btn-next {
  background: #4A90D9;
  color: #fff;
  font-size: 28rpx;
}

.nav-btn-next:active {
  background: #3A7BC8;
}

.nav-btn-share {
  background: #F5A623;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.nav-btn-share:active {
  background: #E09520;
}

.nav-btn.disabled {
  opacity: 0.4;
}

/* ========== 本轮小结页 ========== */
.summary-page {
  padding: 0 0 40rpx;
}

@keyframes zanBounce {
  0%   { transform: scale(0); }
  50%  { transform: scale(1.2); }
  70%  { transform: scale(0.9); }
  100% { transform: scale(1); }
}

.summary-zan {
  display: block;
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 24rpx;
  animation: zanBounce 0.6s ease-out;
}

.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.summary-encourage {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.summary-subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.summary-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.summary-stat-item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.summary-stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.summary-stat-value--green {
  color: #34c759;
}

.summary-stat-value--red {
  color: #ff6b6b;
}

.summary-stat-value--blue {
  color: #4A90D9;
}

.summary-stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.summary-info {
  text-align: center;
  margin-bottom: 24rpx;
}

.summary-info-text {
  font-size: 26rpx;
  color: #999;
}

.summary-wrong-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.summary-wrong-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.summary-wrong-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary-wrong-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.summary-wrong-item:last-child {
  border-bottom: none;
}

.summary-wrong-word {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.summary-wrong-meaning {
  font-size: 24rpx;
  color: #999;
}

.summary-actions {
  display: flex;
  gap: 20rpx;
}

.summary-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.summary-btn-primary {
  background: #4A90D9;
  color: #fff;
}

.summary-btn-primary:active {
  background: #3A7BC8;
}

.summary-btn-orange {
  flex: 1;
  background: #F5A623;
  color: #fff;
}

.summary-btn-orange:active {
  background: #E09520;
}
