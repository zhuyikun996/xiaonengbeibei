<wxs module="utils">
module.exports = {
  formatDuration: function(seconds) {
    if (seconds < 60) return seconds + '秒';
    var min = Math.floor(seconds / 60);
    var sec = seconds % 60;
    return sec > 0 ? min + '分' + sec + '秒' : min + '分钟';
  }
}
</wxs>

<view class="stats">
  <!-- 打卡天数 -->
  <view class="streak-section">
    <view class="streak-item">
      <text class="streak-number">{{streakDays}}</text>
      <text class="streak-label">连续打卡(天)</text>
    </view>
    <view class="streak-divider"></view>
    <view class="streak-item">
      <text class="streak-number">{{totalStudyDays}}</text>
      <text class="streak-label">累计打卡(天)</text>
    </view>
  </view>

  <!-- 词表掌握度 -->
  <view class="section-card" wx:if="{{wordSetProgress.length > 0}}">
    <view class="section-title">词表掌握度</view>
    <view class="mastery-summary">
      <view class="mastery-item">
        <text class="mastery-number mastery-number--green">{{masteredCount}}</text>
        <text class="mastery-label">已掌握</text>
      </view>
      <view class="mastery-item">
        <text class="mastery-number mastery-number--orange">{{reviewCount}}</text>
        <text class="mastery-label">待复习</text>
      </view>
      <view class="mastery-item">
        <text class="mastery-number">{{todayAnswerCount}}</text>
        <text class="mastery-label">今日答题</text>
      </view>
    </view>
    <view class="progress-list">
      <view class="progress-item" wx:for="{{wordSetProgress}}" wx:key="title">
        <view class="progress-info">
          <text class="progress-name">{{item.title}}</text>
          <text class="progress-count">已掌握 {{item.masteredCount}} / {{item.total}}</text>
        </view>
        <view class="progress-bar-bg">
          <view class="progress-bar-fill" style="width: {{item.percent}}%"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 薄弱词 -->
  <view class="section-card" wx:if="{{weakWords.length > 0}}">
    <view class="section-title">薄弱词</view>
    <view class="weak-list">
      <view class="weak-item" wx:for="{{weakWords}}" wx:key="word">
        <view class="weak-info">
          <text class="weak-word">{{item.word}}</text>
          <text class="weak-meaning">{{item.meaning}}</text>
        </view>
        <view class="weak-stats">
          <text class="weak-correct">对{{item.correctCount}}</text>
          <text class="weak-wrong">错{{item.wrongCount}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 学习热力图 -->
  <view class="section-card">
    <view class="section-title">{{currentMonth}}学习记录</view>
    <view class="calendar-header">
      <text class="calendar-week" wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="calendar-grid">
      <view
        class="calendar-day {{item.studied ? 'studied' : ''}} {{item.isToday ? 'today' : ''}}"
        wx:for="{{calendarDays}}"
        wx:key="day"
      >
        <text wx:if="{{item.day}}">{{item.day}}</text>
      </view>
    </view>
    <view class="calendar-legend">
      <view class="legend-item">
        <view class="legend-dot"></view>
        <text class="legend-text">已学习</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot legend-dot-today"></view>
        <text class="legend-text">今天</text>
      </view>
    </view>
  </view>

  <!-- 今日学习 -->
  <view class="section-card">
    <view class="section-title">今日学习</view>
    <view class="today-stats">
      <view class="today-item">
        <text class="today-number">{{todayCount}}</text>
        <text class="today-label">已学单词</text>
      </view>
      <view class="today-item">
        <text class="today-number">{{utils.formatDuration(todayDuration)}}</text>
        <text class="today-label">学习时长</text>
      </view>
      <view class="today-item" wx:if="{{todayAnswerCount > 0}}">
        <text class="today-number">{{todayAccuracy}}%</text>
        <text class="today-label">正确率</text>
      </view>
    </view>
  </view>

  <!-- 分享按钮 -->
  <view class="share-section">
    <view class="share-btn" bindtap="onSharePoster">
      <text class="share-btn-text">分享打卡海报</text>
    </view>
  </view>

  <!-- 海报组件 -->
  <share-poster
    show="{{showPoster}}"
    streakDays="{{totalStudyDays}}"
    bind:close="onClosePoster"
  ></share-poster>
</view>
