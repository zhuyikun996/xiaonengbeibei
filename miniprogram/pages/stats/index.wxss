.stats {
  padding: 24rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 打卡天数 */
.streak-section {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.streak-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.streak-number {
  font-size: 64rpx;
  font-weight: bold;
  color: #4A90D9;
}

.streak-label {
  font-size: 24rpx;
  color: #999;
}

.streak-divider {
  width: 2rpx;
  height: 80rpx;
  background: #e5e5e5;
}

/* 通用卡片 */
.section-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 日历 */
.calendar-header {
  display: flex;
  gap: 0;
  margin-bottom: 12rpx;
}

.calendar-week {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #999;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.calendar-day {
  width: calc((100% - 48rpx) / 7);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
}

.calendar-day.studied {
  background: #4A90D9;
  color: #fff;
}

.calendar-day.today {
  border: 4rpx solid #FF9500;
  color: #FF9500;
  background: #FFF5E6;
}

.calendar-day.studied.today {
  background: #4A90D9;
  color: #fff;
  border-color: #FF9500;
}

.calendar-legend {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  background: #4A90D9;
}

.legend-dot-today {
  background: #FFF5E6;
  border: 3rpx solid #FF9500;
}

.legend-text {
  font-size: 20rpx;
  color: #999;
}

/* 今日学习 */
.today-stats {
  display: flex;
  justify-content: space-around;
}

.today-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.today-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.today-label {
  font-size: 24rpx;
  color: #999;
}

/* 词表进度 */
.progress-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.progress-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-name {
  font-size: 28rpx;
  color: #333;
}

.progress-count {
  font-size: 24rpx;
  color: #999;
}

.progress-bar-bg {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: #4A90D9;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* 分享按钮 */
.share-section {
  margin-top: 16rpx;
  margin-bottom: 40rpx;
}

.share-btn {
  background: #4A90D9;
  border-radius: 44rpx;
  padding: 24rpx 0;
  text-align: center;
}

.share-btn:active {
  background: #3A7BC8;
}

.share-btn-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
}
